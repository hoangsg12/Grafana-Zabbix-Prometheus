{
  "title": "Network Devices Overview (Mikrotik/Cisco/Fortinet)",
  "uid": "network-overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Interface Operational Status (1=up, 2=down)",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "ifOperStatus",
          "format": "table",
          "instant": true,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Inbound Traffic (bytes/s) - by interface",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "rate(ifHCInOctets[5m]) * 8",
          "legendFormat": "{{instance}} - {{ifName}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Outbound Traffic (bytes/s) - by interface",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "rate(ifHCOutOctets[5m]) * 8",
          "legendFormat": "{{instance}} - {{ifName}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Device Uptime",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 16 },
      "targets": [
        {
          "expr": "sysUpTime",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    }
  ]
}
